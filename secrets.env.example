# Copy to secrets.env and replace every value before deploying.
# Keep these credentials safe; do not commit secrets.env.
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-value
MARIADB_DATABASE=nextcloud
MARIADB_USER=nextcloud
MARIADB_PASSWORD=replace-with-another-long-random-value
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-long-random-value
